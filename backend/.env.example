DATABASE_URL=postgresql+psycopg://arakutribe:arakutribe@localhost:5433/arakutribe
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
PENDING_TOKEN_EXPIRE_MINUTES=10
CORS_ORIGINS=http://localhost:5173
UPLOADS_DIR=uploads

# "Sign in with Google" — create an OAuth Client ID (Web application) at
# https://console.cloud.google.com/apis/credentials, add
# GOOGLE_REDIRECT_URI below as an authorized redirect URI, and fill these in.
# Left blank, the Google login button shows a clear "not configured" error
# instead of a broken redirect.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
FRONTEND_BASE_URL=http://localhost:5173

# AI shopping assistant (Claude API). Get a key at https://console.anthropic.com/
# Left blank, the chat widget shows a clear "not configured" error.
ANTHROPIC_API_KEY=

# Transactional email (Resend). Get a key at https://resend.com/api-keys
# Left blank, OTPs/emails are only logged to the backend console (dev mode).
RESEND_API_KEY=
EMAIL_FROM=Araku Tribe <onboarding@resend.dev>
# Where contact-form submissions get emailed — set to a real inbox you own.
CONTACT_NOTIFICATION_EMAIL=
